{
  "name": "gladys-m-reso",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for M réso, the trams and buses of Grenoble (Mobilités M): real-time departures and delays at your stops, traffic of your lines, scenes and dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-m-reso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-m-reso.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "m-reso",
    "mobilites-m",
    "grenoble",
    "public-transport",
    "tram",
    "bus",
    "home-automation"
  ]
}
